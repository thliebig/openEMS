#!/bin/bash
# usage: build-openems [source dir]  -- build fparser, CSXCAD and openEMS into /opt/openEMS and
# install the Python bindings. The source dir (default /workspace/openEMS-Project) holds the
# fparser, CSXCAD and openEMS directories. Rebuilds are incremental.
# The CUDA architecture is the one of the local GPU, or HIP_ARCH (e.g. HIP_ARCH=86).
set -e
SRC=${1:-/workspace/openEMS-Project}
P=/opt/openEMS
B=/workspace/build
J=$(nproc)
ARCH=${HIP_ARCH:-$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader | head -1 | tr -d .)}
LOG=/workspace/logs
mkdir -p $B $LOG

step() {   # step <name> <command...>: run with the output in $LOG/build_<name>.log
	local name=$1; shift
	if ! "$@" > $LOG/build_$name.log 2>&1; then
		echo "build-openems: $name failed, see $LOG/build_$name.log"
		grep -E "error|Error" $LOG/build_$name.log | head -20
		exit 1
	fi
}
build() {  # build <dir> <cmake options...>: configure once, then make and install
	local dir=$1; shift
	if [ ! -f $B/$dir/CMakeCache.txt ]; then
		step ${dir}_cmake cmake -S $SRC/$dir -B $B/$dir -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$P "$@"
	fi
	step $dir make -C $B/$dir -j$J install
}

echo "build-openems: $SRC, CUDA architecture $ARCH"
build fparser
build CSXCAD -DFPARSER_ROOT_DIR=$P
build openEMS -DFPARSER_ROOT_DIR=$P -DCSXCAD_ROOT_DIR=$P -DCMAKE_HIP_ARCHITECTURES=$ARCH
grep -h "HIP GPU backend" $LOG/build_openEMS_cmake.log 2>/dev/null || true

for py in CSXCAD openEMS; do
	(cd $SRC/$py/python && rm -rf build && \
	 CSXCAD_INSTALL_PATH=$P OPENEMS_INSTALL_PATH=$P VIRTUAL_ENV=$P/venv \
	 $P/venv/bin/pip install --no-build-isolation --force-reinstall --no-deps . > $LOG/build_py_$py.log 2>&1) \
	|| { echo "build-openems: Python $py failed, see $LOG/build_py_$py.log"; tail -20 $LOG/build_py_$py.log; exit 1; }
done
(cd /tmp && $P/venv/bin/python -c "import CSXCAD, openEMS")
echo "build-openems: done"
